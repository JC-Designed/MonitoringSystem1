@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "USERS";
}

<div class="users-page container-fluid py-4">
    <div class="card shadow-sm rounded-4 p-4">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold mb-0">USERS LIST</h5>
        </div>

        <!-- Filters -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label fw-semibold small mb-2">Search by Lastname</label>
                <input type="text" id="searchName" class="form-control filter-box" placeholder="Type name..." />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold small mb-2">User Type</label>
                <select id="userTypeFilter" class="form-select filter-box">
                    <option value="">All</option>
                    <option value="Student">Student</option>
                    <option value="Company">Company</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold small mb-2">School Year</label>
                <select id="schoolYearFilter" class="form-select filter-box">
                    <option value="">All Years</option>
                    <option value="2024-2025">2024-2025</option>
                    <option value="2025-2026">2025-2026</option>
                </select>
            </div>
        </div>

        <!-- Users Table -->
        <div class="table-responsive">
            <table class="table table-hover table-borderless align-middle mb-0" id="usersTable">
                <thead class="table-light">
                    <tr>
                        <th class="col-id">ID</th>
                        <th class="col-name">Name</th>
                        <th class="col-email">Email</th>
                        <th class="col-company">Company</th>
                        <th class="col-year">School Year</th>
                        <th class="text-end col-action">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Student Example -->
                    <tr data-type="Student"
                        data-name="Jane Smith"
                        data-email="jane@example.com"
                        data-student-id="2024-00123"
                        data-company="Global Industries"
                        data-year="2024-2025">
                        <td>2024-00123</td>
                        <td>Jane Smith</td>
                        <td>jane@example.com</td>
                        <td>Global Industries</td>
                        <td>2024-2025</td>
                        <td class="text-end">
                            <div class="dropdown d-flex justify-content-end">
                                <button class="btn btn-white btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown"></button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li><a class="dropdown-item edit-btn" href="#">Edit</a></li>
                                    <li><a class="dropdown-item delete-btn" href="#">Delete</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>

                    <!-- Company Example -->
                    <tr data-type="Company"
                        data-name="Global Industries HR"
                        data-email="hr@globalindustries.com"
                        data-company="Global Industries"
                        data-year="2025-2026">
                        <td>COMP-2025-0045</td>
                        <td>Global Industries HR</td>
                        <td>hr@globalindustries.com</td>
                        <td>Global Industries</td>
                        <td>2025-2026</td>
                        <td class="text-end">
                            <div class="dropdown d-flex justify-content-end">
                                <button class="btn btn-white btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown"></button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li><a class="dropdown-item edit-btn" href="#">Edit</a></li>
                                    <li><a class="dropdown-item delete-btn" href="#">Delete</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================= EDIT MODAL ================= -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" id="editName">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" id="editEmail">
                    </div>
                    <div class="mb-3" id="editStudentIDWrapper">
                        <label class="form-label">Student ID</label>
                        <input type="text" class="form-control" id="editStudentID">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Company</label>
                        <input type="text" class="form-control" id="editCompany">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">New Password</label>
                        <input type="password" class="form-control" id="editPassword" placeholder="Leave blank to keep current">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Confirm Password</label>
                        <input type="password" class="form-control" id="editConfirmPassword" placeholder="Re-type new password">
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Save Changes</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ================= DELETE MODAL ================= -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="deleteMessage"></p>
                <div class="d-flex justify-content-between">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button id="confirmDeleteBtn" class="btn btn-danger">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= SCRIPT ================= -->
<script>
    const tbody = document.querySelector("#usersTable tbody");
    let rowToEdit = null;
    let rowToDelete = null;

    // ===== FILTER TABLE =====
    function filterTable() {
        const nameVal = document.getElementById("searchName").value.toLowerCase();
        const typeVal = document.getElementById("userTypeFilter").value;
        const yearVal = document.getElementById("schoolYearFilter").value;

        [...tbody.rows].forEach(row => {
            let show = true;
            const type = row.dataset.type;

            if(nameVal && !row.dataset.name.toLowerCase().includes(nameVal)) show = false;
            if(typeVal && type !== typeVal) show = false;
            if(yearVal && row.dataset.year !== yearVal) show = false;

            row.style.display = show ? "" : "none";
        });
    }
    ['searchName','userTypeFilter','schoolYearFilter'].forEach(id => {
        document.getElementById(id).addEventListener('input', filterTable);
    });

    // ===== EDIT =====
    document.querySelectorAll('.edit-btn').forEach(btn=>{
        btn.addEventListener('click', e=>{
            e.preventDefault();
            rowToEdit = btn.closest('tr');
            const type=rowToEdit.dataset.type;

            document.getElementById('editName').value=rowToEdit.dataset.name;
            document.getElementById('editEmail').value=rowToEdit.dataset.email;
            document.getElementById('editCompany').value=rowToEdit.dataset.company || rowToEdit.dataset.name;

            if(type==='Student'){
                document.getElementById('editStudentIDWrapper').style.display='block';
                document.getElementById('editStudentID').value=rowToEdit.dataset.studentId;
            } else {
                document.getElementById('editStudentIDWrapper').style.display='none';
            }

            document.getElementById('editPassword').value = '';
            document.getElementById('editConfirmPassword').value = '';

            bootstrap.Modal.getOrCreateInstance(document.getElementById("editModal")).show();
        });
    });

    document.getElementById('editForm').addEventListener('submit', e=>{
        e.preventDefault();
        if(!rowToEdit) return;

        const newName = document.getElementById('editName').value;
        const newEmail = document.getElementById('editEmail').value;
        const newCompany = document.getElementById('editCompany').value;

        rowToEdit.dataset.name = newName;
        rowToEdit.dataset.email = newEmail;
        rowToEdit.dataset.company = newCompany;

        rowToEdit.cells[1].textContent = newName;
        rowToEdit.cells[2].textContent = newEmail;
        rowToEdit.cells[3].textContent = newCompany;

        if(rowToEdit.dataset.type === 'Student'){
            rowToEdit.dataset.studentId = document.getElementById('editStudentID').value;
        }

        const newPassword = document.getElementById('editPassword').value;
        const confirmPassword = document.getElementById('editConfirmPassword').value;

        if(newPassword){
            if(newPassword !== confirmPassword){
                alert("Passwords do not match!");
                return;
            }
            rowToEdit.dataset.password = newPassword;
        }

        bootstrap.Modal.getOrCreateInstance(document.getElementById("editModal")).hide();
        rowToEdit=null;
    });

    // ===== DELETE =====
    document.querySelectorAll('.delete-btn').forEach(btn=>{
        btn.addEventListener('click', e=>{
            e.preventDefault();
            rowToDelete=btn.closest('tr');
            document.getElementById('deleteMessage').textContent=`Are you sure you want to delete ${rowToDelete.dataset.name}?`;
            bootstrap.Modal.getOrCreateInstance(document.getElementById("deleteModal")).show();
        });
    });

    document.getElementById('confirmDeleteBtn').addEventListener('click', ()=>{
        if(rowToDelete){
            rowToDelete.remove();
            rowToDelete=null;
            bootstrap.Modal.getOrCreateInstance(document.getElementById("deleteModal")).hide();
        }
    });
</script>
