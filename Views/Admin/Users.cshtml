@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "USERS";
}

<div class="users-page container-fluid py-4">
    <div class="card shadow-sm rounded-4 p-4">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold mb-0">USERS LIST</h5>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm d-flex align-items-center px-3">
                    <i class="bi bi-download me-1"></i> Download PDF
                </button>
                <button class="btn btn-danger btn-sm d-flex align-items-center px-3">
                    <i class="bi bi-plus-lg me-1"></i> Create User
                </button>
            </div>
        </div>

        <!-- Filters -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <label class="form-label fw-semibold small mb-2">Search by Name</label>
                <input type="text" id="searchName" class="form-control filter-box" placeholder="Type name..." />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small mb-2">User Type</label>
                <select id="userTypeFilter" class="form-select filter-box">
                    <option value="">All</option>
                    <option value="Student">Student</option>
                    <option value="Company">Company</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small mb-2">Company</label>
                <select id="companyFilter" class="form-select filter-box">
                    <option value="">All Companies</option>
                    <option value="Tech Solutions">Tech Solutions</option>
                    <option value="Global Industries">Global Industries</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small mb-2">School Year</label>
                <select id="schoolYearFilter" class="form-select filter-box">
                    <option value="">All Years</option>
                    <option value="2024-2025">2024-2025</option>
                    <option value="2025-2026">2025-2026</option>
                </select>
            </div>
        </div>

        <!-- Users Table -->
        <div class="table-responsive">
            <table class="table table-hover table-borderless align-middle mb-0" id="usersTable">
                <thead class="table-light">
                    <tr>
                        <th class="col-id">ID</th>
                        <th class="col-name">Name</th>
                        <th class="col-email">Email</th>
                        <th class="col-company">Company</th>
                        <th class="col-year">School Year</th>
                        <th class="text-end col-action">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Student Example -->
                    <tr data-type="Student"
                        data-banner="/images/student-banner.jpg"
                        data-profile="/images/student-profile.jpg"
                        data-name="Jane Smith"
                        data-email="jane@example.com"
                        data-student-id="2024-00123"
                        data-address="123 Main St, City"
                        data-contact="09171234567"
                        data-emergency-contact="John Doe - 09179876543"
                        data-company="Global Industries"
                        data-year="2024-2025"
                        data-company-name="Global Industries HR"
                        data-company-address="789 Global Ave"
                        data-company-email="hr@globalindustries.com"
                        data-company-contact="09171234568"
                        data-company-industry="Manufacturing"
                        data-company-supervisor="Ms. Grace Hopper"
                        data-company-slots="10"
                        data-students='[{"name":"Jane Smith","course":"IT","remaining":"30 days"}]'>
                        <td>2024-00123</td>
                        <td>Jane Smith</td>
                        <td>jane@example.com</td>
                        <td>Global Industries</td>
                        <td>2024-2025</td>
                        <td class="text-end">
                            <div class="dropdown d-flex justify-content-end">
                                <button class="btn btn-white btn-sm dropdown-toggle action-btn" type="button" data-bs-toggle="dropdown"></button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li><a class="dropdown-item edit-btn" href="#">Edit</a></li>
                                    <li><a class="dropdown-item delete-btn" href="#">Delete</a></li>
                                    <li><a class="dropdown-item view-profile-btn" href="#">View Profile</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>

                    <!-- Company Example -->
                    <tr data-type="Company"
                        data-banner="/images/company-banner.jpg"
                        data-profile="/images/company-logo.jpg"
                        data-name="Global Industries HR"
                        data-email="hr@globalindustries.com"
                        data-address="789 Global Ave"
                        data-contact="09171234568"
                        data-industry="Manufacturing"
                        data-supervisor="Ms. Grace Hopper"
                        data-slots="10"
                        data-students='[{"name":"Jane Smith","course":"IT","remaining":"30 days"},{"name":"Alice","course":"IT","remaining":"30 days"}]'
                        data-year="2025-2026"
                        data-company="Global Industries">
                        <td>COMP-2025-0045</td>
                        <td>Global Industries HR</td>
                        <td>hr@globalindustries.com</td>
                        <td>Global Industries</td>
                        <td>2025-2026</td>
                        <td class="text-end">
                            <div class="dropdown d-flex justify-content-end">
                                <button class="btn btn-white btn-sm dropdown-toggle action-btn" type="button" data-bs-toggle="dropdown"></button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li><a class="dropdown-item edit-btn" href="#">Edit</a></li>
                                    <li><a class="dropdown-item delete-btn" href="#">Delete</a></li>
                                    <li><a class="dropdown-item view-profile-btn" href="#">View Profile</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ================= PROFILE MODAL ================= -->
<div class="modal fade" id="profileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">
            <!-- Header -->
            <div class="modal-header position-relative p-0 border-0">
                <div id="profileBanner" style="width:100%; height:140px; background-size:cover; background-position:center; border-top-left-radius:0.75rem; border-top-right-radius:0.75rem;"></div>
                <div class="position-absolute w-100 d-flex justify-content-center" style="bottom:-70px;">
                    <img id="profilePicture" class="rounded-circle border border-3 border-white shadow" style="width:140px; height:140px; object-fit:cover;">
                </div>
            </div>
            <div style="height:70px;"></div>

            <!-- Body -->
            <div class="modal-body pt-2 px-5 pb-4">
                <div class="text-center mb-4">
                    <h3 id="profileName" class="fw-bold mb-1"></h3>
                    <span id="profileType" class="text-muted"></span>
                </div>

                <!-- Student Info -->
                <div id="studentFields" style="display:none;">
                    <div class="info-card bg-light p-4">
                        <div class="row g-3">
                            <div class="col-md-6"><strong>Email:</strong> <span id="profileEmail"></span></div>
                            <div class="col-md-6"><strong>Student ID:</strong> <span id="profileStudentID"></span></div>
                            <div class="col-md-6"><strong>Address:</strong> <span id="profileAddress"></span></div>
                            <div class="col-md-6"><strong>Contact:</strong> <span id="profileContact"></span></div>
                            <div class="col-md-6"><strong>Emergency Contact:</strong> <span id="profileEmergency"></span></div>
                            <div class="col-md-6"><strong>Company:</strong> <a href="#" id="profileCompanyLink"></a></div>
                            <div class="col-md-6"><strong>School Year:</strong> <span id="profileYear"></span></div>
                        </div>
                    </div>
                </div>

                <!-- Company Info -->
                <div id="companyFields" style="display:none;">
                    <div class="info-card bg-light p-4">
                        <div class="row g-3">
                            <div class="col-md-6"><strong>Name:</strong> <span id="companyName"></span></div>
                            <div class="col-md-6"><strong>Address:</strong> <span id="companyAddress"></span></div>
                            <div class="col-md-6"><strong>Email:</strong> <span id="companyEmail"></span></div>
                            <div class="col-md-6"><strong>Contact:</strong> <span id="companyContact"></span></div>
                            <div class="col-md-6"><strong>Industry:</strong> <span id="companyIndustry"></span></div>
                            <div class="col-md-6"><strong>Supervisor:</strong> <span id="companySupervisor"></span></div>
                            <div class="col-md-6"><strong>Slots Available:</strong> <span id="companySlots"></span></div>
                        </div>
                        <div class="mt-4">
                            <h6 class="fw-bold mb-3">Students under this company</h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Name</th>
                                            <th>Course</th>
                                            <th>Remaining OJT</th>
                                        </tr>
                                    </thead>
                                    <tbody id="companyStudentsList"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer justify-content-center border-0">
                <button class="btn btn-secondary px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- ================= EDIT MODAL ================= -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" class="form-control" id="editName">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control" id="editEmail">
                    </div>
                    <div class="mb-3" id="editStudentIDWrapper">
                        <label class="form-label">Student ID</label>
                        <input type="text" class="form-control" id="editStudentID">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Company</label>
                        <input type="text" class="form-control" id="editCompany">
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Save Changes</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ================= DELETE MODAL ================= -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="deleteMessage"></p>
                <div class="d-flex justify-content-between">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button id="confirmDeleteBtn" class="btn btn-danger">Delete</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ================= SCRIPT ================= -->
<script>
    const tbody = document.querySelector("#usersTable tbody");
    let rowToEdit = null;
    let rowToDelete = null;

    // ===== FILTER TABLE =====
    function filterTable() {
        const nameVal = document.getElementById("searchName").value.toLowerCase();
        const typeVal = document.getElementById("userTypeFilter").value;
        const companyVal = document.getElementById("companyFilter").value;
        const yearVal = document.getElementById("schoolYearFilter").value;

        [...tbody.rows].forEach(row => {
            let show = true;
            const type = row.dataset.type;

            if(nameVal && !row.dataset.name.toLowerCase().includes(nameVal)) show = false;
            if(typeVal && type !== typeVal) show = false;
            if(companyVal){
                if(type === "Student" && row.dataset.company !== companyVal) show = false;
                if(type === "Company" && row.dataset.name !== companyVal) show = false;
            }
            if(yearVal && row.dataset.year !== yearVal) show = false;

            row.style.display = show ? "" : "none";
        });
    }
    ['searchName','userTypeFilter','companyFilter','schoolYearFilter'].forEach(id => {
        document.getElementById(id).addEventListener('input', filterTable);
    });

    // ===== POPULATE PROFILE MODAL =====
    function populateModal(row){
        const type = row.dataset.type;
        document.getElementById('profileBanner').style.backgroundImage = `url('${row.dataset.banner}')`;
        document.getElementById('profilePicture').src = row.dataset.profile;
        document.getElementById('profileName').textContent = row.dataset.name;
        document.getElementById('profileType').textContent = type;
        document.getElementById('profileYear').textContent = row.dataset.year || 'N/A';
        document.getElementById('profileEmail').textContent = row.dataset.email || '';
        document.getElementById('profileStudentID').textContent = row.dataset.studentId || '';
        document.getElementById('profileAddress').textContent = row.dataset.address || '';
        document.getElementById('profileContact').textContent = row.dataset.contact || '';
        document.getElementById('profileEmergency').textContent = row.dataset.emergencyContact || '';

        const students = JSON.parse(row.dataset.students || '[]');

        if(type === 'Student'){
            document.getElementById('studentFields').style.display='block';
            document.getElementById('companyFields').style.display='none';
            const companyLink = document.getElementById('profileCompanyLink');
            companyLink.textContent = row.dataset.company;
            companyLink.href = '#';
            companyLink.onclick = e => {
                e.preventDefault();
                const companyRow = [...tbody.rows].find(r => r.dataset.type === 'Company' && r.dataset.name === row.dataset.companyName);
                if(companyRow) populateModal(companyRow);
                bootstrap.Modal.getOrCreateInstance(document.getElementById("profileModal")).show();
            }
        } else {
            document.getElementById('studentFields').style.display='none';
            document.getElementById('companyFields').style.display='block';
            document.getElementById('companyName').textContent = row.dataset.name;
            document.getElementById('companyAddress').textContent = row.dataset.address || '';
            document.getElementById('companyEmail').textContent = row.dataset.email || '';
            document.getElementById('companyContact').textContent = row.dataset.contact || '';
            document.getElementById('companyIndustry').textContent = row.dataset.industry || '';
            document.getElementById('companySupervisor').textContent = row.dataset.supervisor || '';
            document.getElementById('companySlots').textContent = row.dataset.slots || '';
            const tbodyCompany = document.getElementById('companyStudentsList');
            tbodyCompany.innerHTML = '';
            students.forEach(s => {
                const tr = document.createElement('tr');
                tr.innerHTML = `<td>${s.name}</td><td>${s.course}</td><td>${s.remaining}</td>`;
                tbodyCompany.appendChild(tr);
            });
        }
    }

    // ===== VIEW PROFILE =====
    document.querySelectorAll('.view-profile-btn').forEach(btn=>{
        btn.addEventListener('click',()=>populateModal(btn.closest('tr')) && bootstrap.Modal.getOrCreateInstance(document.getElementById("profileModal")).show());
    });

    // ===== EDIT =====
    document.querySelectorAll('.edit-btn').forEach(btn=>{
        btn.addEventListener('click', e=>{
            e.preventDefault();
            rowToEdit = btn.closest('tr');
            const type=rowToEdit.dataset.type;
            document.getElementById('editName').value=rowToEdit.dataset.name;
            document.getElementById('editEmail').value=rowToEdit.dataset.email;
            document.getElementById('editCompany').value=rowToEdit.dataset.company || rowToEdit.dataset.name;
            if(type==='Student'){ document.getElementById('editStudentIDWrapper').style.display='block'; document.getElementById('editStudentID').value=rowToEdit.dataset.studentId; }
            else document.getElementById('editStudentIDWrapper').style.display='none';
            bootstrap.Modal.getOrCreateInstance(document.getElementById("editModal")).show();
        });
    });

    document.getElementById('editForm').addEventListener('submit', e=>{
        e.preventDefault();
        if(!rowToEdit) return;
        rowToEdit.dataset.name=document.getElementById('editName').value;
        rowToEdit.dataset.email=document.getElementById('editEmail').value;
        if(rowToEdit.dataset.type==='Student') rowToEdit.dataset.studentId=document.getElementById('editStudentID').value;
        rowToEdit.dataset.company=document.getElementById('editCompany').value;
        rowToEdit.cells[1].textContent=rowToEdit.dataset.name;
        rowToEdit.cells[2].textContent=rowToEdit.dataset.email;
        rowToEdit.cells[3].textContent=rowToEdit.dataset.company;
        bootstrap.Modal.getOrCreateInstance(document.getElementById("editModal")).hide();
        rowToEdit=null;
    });

    // ===== DELETE =====
    document.querySelectorAll('.delete-btn').forEach(btn=>{
        btn.addEventListener('click', e=>{
            e.preventDefault();
            rowToDelete=btn.closest('tr');
            document.getElementById('deleteMessage').textContent=`Are you sure you want to delete ${rowToDelete.dataset.name}?`;
            bootstrap.Modal.getOrCreateInstance(document.getElementById("deleteModal")).show();
        });
    });
    document.getElementById('confirmDeleteBtn').addEventListener('click',()=>{
        if(rowToDelete){ rowToDelete.remove(); rowToDelete=null; bootstrap.Modal.getOrCreateInstance(document.getElementById("deleteModal")).hide(); }
    });
</script>
