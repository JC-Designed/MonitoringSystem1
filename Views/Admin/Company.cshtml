@model IEnumerable<MonitoringSystem.Models.Company>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Company List";
}

<div class="container-fluid py-4">
    <div class="card shadow-sm rounded-4 p-4">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold mb-0">Company List</h5>
            <a href="@Url.Action("CreateCompany", "Admin")" class="btn btn-success btn-sm">Add New Company</a>
        </div>

        <!-- Search Bar -->
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <input type="text" id="searchCompany" class="form-control form-control-sm shadow-sm"
                       placeholder="Search company by name..." />
            </div>
        </div>

        <!-- Company Table -->
        <div class="table-responsive">
            <table class="table table-hover table-borderless align-middle mb-0 shadow-sm rounded" id="companyTable">
                <thead class="table-light">
                    <tr>
                        <th style="width:10%;">ID</th>
                        <th style="width:25%;">Name</th>
                        <th style="width:25%;">Email</th>
                        <th style="width:25%;">Industry</th>
                        <th style="width:15%;" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var company in Model)
                    {
                        <tr class="company-row" data-name="@company.Name">
                            <td>@company.Id</td>
                            <td>@company.Name</td>
                            <td>@company.Email</td>
                            <td>@company.Industry</td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown"></button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li>
                                            <a class="dropdown-item" href="@Url.Action("CompanyProfile", "Admin", new { id = company.Id })">View Profile</a>
                                        </li>
                                        <li>
                                            <form method="post" action="@Url.Action("DeleteCompany", "Admin", new { id = company.Id })" onsubmit="return confirm('Are you sure you want to delete @company.Name?');">
                                                <button type="submit" class="dropdown-item text-danger">Delete</button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    // SEARCH
    const searchInput = document.getElementById("searchCompany");
    const tableRows = document.querySelectorAll("#companyTable tbody tr");

    searchInput.addEventListener("input", function () {
        const val = this.value.toLowerCase();
        tableRows.forEach(row => {
            row.style.display = row.dataset.name.toLowerCase().includes(val) ? "" : "none";
        });
    });
</script>
