@model MonitoringSystem.Models.Company
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Add Company";
}

<h3 class="fw-bold text-primary mb-4">Add New Company</h3>

<form asp-action="CreateCompany" method="post">
    <div class="mb-3">
        <label class="form-label">Company Name</label>
        <input asp-for="Name" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Address</label>
        <input asp-for="Address" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Email" class="form-control" type="email" required />
    </div>
    <button type="submit" class="btn btn-success">
        <i class="bi bi-check-lg"></i> Save
    </button>
    <a asp-action="Company" class="btn btn-secondary">Cancel</a>
</form>
