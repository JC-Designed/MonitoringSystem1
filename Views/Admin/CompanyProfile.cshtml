@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Company Profile";
    var companyName = Request.Query["name"];
    var companyEmail = Request.Query["email"];
    var companyIndustry = Request.Query["industry"];
}

<div class="container py-4">
    <div class="card shadow-sm rounded-4 p-4">
        <!-- Banner -->
        <div class="mb-4" style="height:180px; background-color:#0d6efd; border-radius:12px;"></div>

        <!-- Company Info -->
        <h3 class="fw-bold">@companyName</h3>
        <p><strong>Email:</strong> @companyEmail</p>
        <p><strong>Industry:</strong> @companyIndustry</p>

        <!-- Employees Demo -->
        <h5 class="mt-4 fw-bold">Employees</h5>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="card p-3 shadow-sm rounded-3">
                    <h6 class="fw-bold mb-1">Jane Smith</h6>
                    <p class="mb-0">jane@example.com</p>
                </div>
            </div>
            <div class="col-md-4">


                <div class="card p-3 shadow-sm rounded-3">
                    <h6 class="fw-bold mb-1">John Doe</h6>
                    <p class="mb-0">john@example.com</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card p-3 shadow-sm rounded-3">
                    <h6 class="fw-bold mb-1">Alice Johnson</h6>
                    <p class="mb-0">alice@example.com</p>
                </div>
            </div>
        </div>
    </div>
</div>
